# Copy to .env. A provider without a key uses its local fake.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000
STORAGE_DIR=./storage

PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
FIRECRAWL_API_KEY=
FEATHERLESS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3

MGX_MCP_URL=http://localhost:3100/mcp
ASIAKASTIETO_URL=http://localhost:3000/mock/asiakastieto

# Google Chrome or Chrome for Testing (Revideo needs H.264 in WebCodecs, so not open-source Chromium)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
